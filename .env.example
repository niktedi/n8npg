# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# n8n version: one tag for both n8nio/n8n and n8nio/runners (they must match).
# Use the current stable tag from https://hub.docker.com/r/n8nio/n8n/tags
N8N_VERSION=

TZ=Europe/Warsaw

# --- PostgreSQL superuser (admin only, not used by n8n) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- n8n internal database ---
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# --- application database (business data used by workflows) ---
APP_DB=app
APP_DB_USER=app
APP_DB_PASSWORD=

# --- n8n secrets ---
# Encrypts stored credentials. Back it up: losing it = losing all credentials.
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=

# --- URL ---
# Behind an HTTPS reverse proxy:
#   N8N_HOST=n8n.example.com  N8N_PROTOCOL=https  N8N_WEBHOOK_URL=https://n8n.example.com/
# Via SSH tunnel only (ssh -L 5678:localhost:5678 <server>):
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
